    void LoadForm(JsonObject c)
    {
        var src = c ?? new JsonObject();
        _f["tipo"] = src.S("tipo", "livro");
        _f["modo"] = src.S("modo", "direta");
        foreach (var k in FKeys) _f[k] = src.S(k);
        _f["trecho"] = src.S("trecho");
        _f["nota"] = src.S("nota");
        _f["parte"] = c != null ? c.S("parte") : (_curPart?.S("id") ?? "");

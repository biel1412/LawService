@inherits PageBase
@using static LawService.Abnt
@*  TCC — partes do trabalho, citações, referências ABNT e exportação. *@

@* ─────────────── lateral (partes) *@
<div class="side" style="width:290px">
    <div class="col side-in" style="gap:12px;padding:20px 12px 12px 16px">
        <div class="panel-head">
            <div class="h1">TCC</div>
            <span class="sp"></span>
            <button class="btn soft" title="Nova parte" @onclick="NewPart"><Ic N="plus" C="@T["accent"]" S="16" /><span>Parte</span></button>
        </div>
        @{
            int total = Parts.Objs().Sum(PartWords);
            int meta = M.I("meta_palavras");
            int prontas = Parts.Objs().Count(p => p.S("status") == "pronto");
            int nRefs = Cits.Objs().Select(FonteKey).Distinct().Count();
        }
        <div class="card row" style="gap:12px;padding:10px 12px">
            <Ring Size="56" Value="@(meta > 0 ? (double)total / meta : 0)" />
            <div class="col grow" style="gap:1px">
                <div class="h3">@Thousands(total) palavras</div>
                <div class="faint">@(meta > 0 ? $"meta: {Thousands(meta)}" : "sem meta definida")</div>
                <div class="faint">@prontas de @Parts.Count partes prontas</div>
            </div>
        </div>
        <div class="caption">ESTRUTURA DO TRABALHO</div>
        <div class="scroll grow reorder @(_dragKind == "part" ? "dragging" : "")">
            @{
                int i = 1;
            }
            @foreach (var p in Parts.Objs())
            {
                var pp = p;
                var id = p.S("id");
                var st = STATUS_PARTE.FirstOrDefault(s => s.key == p.S("status", "afazer"));
                if (st.key == null) st = STATUS_PARTE[0];
                int pm = p.I("meta");
                <div class="part @(p == _curPart ? "sel" : "") @DropCls("part", id)" draggable="true"
                     @ondragstart='() => DragStart("part", id)' @ondragend="DragEnd"
                     @onclick="() => ClickPart(pp)" @oncontextmenu="e => PartMenu(pp, e)" @oncontextmenu:preventDefault="true">
                    <span class="part-num" style="background:@Tint(st.color, .82);color:@Ink(st.color, .25)">@(i++)</span>
                    <div class="col grow">
                        <div class="ell" style="font-weight:600">@p.S("titulo")</div>
                        <div class="faint ell">@st.text · @PartWords(p) palavras@(pm > 0 ? $" de {pm}" : "")</div>
                    </div>
                    @DropZones("part", id)
                </div>
            }
        </div>
        <div class="faint wrap">Arraste para reordenar · botão direito: opções</div>
        <div class="card row" style="gap:8px;padding:8px 8px 8px 12px">
            <Ic N="bookshelf" C="@T["muted"]" S="18" />
            <span class="muted grow">Referências · @nRefs fonte(s)</span>
            <button class="tool" title="Ver referências" @onclick='() => SetView("refs")'><Ic N="arrow-right" C="@T["muted"]" /></button>
        </div>
    </div>
</div>

<div class="main">
    <div class="toolbar">
        <div class="row" style="gap:8px;padding:12px 20px 12px 24px">
            <div class="h2 grow ell" title="@(M.S("titulo").Length > 0 ? M.S("titulo") : "Meu TCC")">@HeadTitle</div>
            <Segmented Options="ViewOpts" Value="@_view" ValueChanged="SetView" />
        </div>
    </div>
    <div class="stack grow">
        @* ─────────────── escrever *@
        <div class="row" style="position:absolute;inset:0;gap:14px;padding:14px 16px 12px 22px;align-items:stretch;display:@(_view == "escrever" ? "flex" : "none")">
            <div class="col grow" style="gap:10px">
                <div class="row" style="gap:8px">
                    <input class="bare grow" style="font-size:@Ui.Pt(18);font-weight:700" placeholder="Título da parte" value="@_pTitle" @oninput="TitleEdit" />
                    <select class="field" style="width:150px" value="@(_curPart?.S("status", "afazer") ?? "afazer")" @onchange="e => { if (_curPart != null) SetStatus(_curPart, V(e)); }">
                        @foreach (var (k, n, c) in STATUS_PARTE)
                        {
                            <option value="@k">● @n</option>
                        }
                    </select>
                </div>
                <div class="row" style="background:@T["surface2"];border:1px solid @T["border"];border-radius:10px;padding:4px 6px;gap:1px;flex-wrap:wrap">
                    <button class="tool" title="Desfazer" @onclick='() => _ed.Cmd("undo")'><Ic N="undo" /></button>
                    <button class="tool" title="Refazer" @onclick='() => _ed.Cmd("redo")'><Ic N="redo" /></button>
                    <span class="vline"></span>
                    <button class="tool" title="Negrito" @onclick='() => _ed.Cmd("bold")'><Ic N="format-bold" /></button>
                    <button class="tool" title="Itálico" @onclick='() => _ed.Cmd("italic")'><Ic N="format-italic" /></button>
                    <button class="tool" title="Sublinhado" @onclick='() => _ed.Cmd("underline")'><Ic N="format-underline" /></button>
                    <span class="vline"></span>
                    <button class="tool" title="Esquerda" @onclick='() => _ed.Cmd("align", "left")'><Ic N="format-align-left" /></button>
                    <button class="tool" title="Centralizar" @onclick='() => _ed.Cmd("align", "center")'><Ic N="format-align-center" /></button>
                    <button class="tool" title="Justificar" @onclick='() => _ed.Cmd("align", "justify")'><Ic N="format-align-justify" /></button>
                    <span class="vline"></span>
                    <button class="btn ghost sm" title="Parágrafo ABNT: recuo de 1,25 cm, espaçamento 1,5, justificado" @onclick='() => _ed.Cmd("abnt", Fonte)'><Ic N="format-paragraph" S="16" /><span>ABNT</span></button>
                    <button class="btn ghost sm" title="Título de seção (ex.: 2.1 A RESPONSABILIDADE CIVIL)" @onclick='() => _ed.Cmd("secao", Fonte)'><Ic N="format-header-pound" S="16" /><span>Seção</span></button>
                    <button class="btn ghost sm" title="Recuo de 4 cm, fonte 10, espaçamento simples (mais de 3 linhas)" @onclick='() => _ed.Cmd("longa", Fonte)'><Ic N="format-quote-close" S="16" /><span>Citação longa</span></button>
                </div>
                <div class="paper grow" style="padding:18px 12px 10px 36px;flex-direction:row">
                    <RichEditor @ref="_ed" Mode="tcc" OnChanged="TextChanged" />
                </div>
                <div class="row">
                    <span class="faint">@PartInfo()</span>
                    <span class="sp"></span>
                    <span class="faint">Salvo automaticamente</span>
                </div>
            </div>
            @* painel lateral de citações *@
            <div class="card col" style="width:300px;flex:none;gap:8px;padding:14px 12px 12px 14px">
                <div class="row">
                    <div class="h3">Citações</div>
                    <span class="sp"></span>
                    <button class="tool" title="Nova citação" @onclick='async () => { await SetView("citacoes"); NewCit(); }'><Ic N="plus" C="@T["accent"]" /></button>
                </div>
                <SearchBox @ref="_qSearch" Placeholder="Buscar citação…" Value="@_qq" ValueChanged="v => _qq = v" />
                <Segmented Options="QOnlyOpts" Value="@_qOnly" ValueChanged="v => _qOnly = v" />
                <div class="scroll grow" style="padding-right:4px">
                    @{
                        var quick = QuickList();
                        bool only = _qOnly == "parte" && _curPart != null;
                        bool maiusc = M.B("autor_maiusc", true);
                    }
                    @if (quick.Count == 0)
                    {
                        <div class="faint wrap">@(only ? "Nenhuma citação ligada a esta parte. Veja “Todas” ou cadastre na aba Citações." : "Nenhuma citação encontrada.")</div>
                    }
                    @foreach (var c in quick)
                    {
                        var cc = c;
                        var tr = Collapse(c.S("trecho").Length > 0 ? c.S("trecho") : c.S("nota"));
                        <div class="quick">
                            <div class="serif wrap" style="font-size:@Ui.Pt(9.5)">@(tr.Length > 0 ? tr[..Math.Min(120, tr.Length)] + (tr.Length > 120 ? "…" : "") : "(sem trecho)")</div>
                            <div class="faint wrap">@CitacaoTxt(c, maiusc: maiusc)</div>
                            <div class="row" style="gap:4px">
                                <button class="btn soft sm" title="Entre aspas, com página" @onclick='() => InsertCit(cc, "direta")'>Direta</button>
                                <button class="btn sm" title="Bloco com recuo de 4 cm" @onclick='() => InsertCit(cc, "longa")'>Longa</button>
                                <button class="btn sm" title="Só a chamada (AUTOR, ano)" @onclick='() => InsertCit(cc, "indireta")'>Indireta</button>
                            </div>
                        </div>
                    }
                </div>
                <div class="faint wrap">Clique onde quer inserir no texto e escolha o formato.</div>
            </div>
        </div>

        @* ─────────────── citações *@
        <div class="row" style="position:absolute;inset:0;gap:16px;padding:16px 22px 14px;align-items:stretch;display:@(_view == "citacoes" ? "flex" : "none")">
            <div class="col" style="flex:5;min-width:0;gap:8px">
                <div class="row" style="gap:8px">
                    <SearchBox @ref="_cSearch" Class="grow" Placeholder="Buscar no trecho, autor, título, tags…" Value="@_cq" ValueChanged="v => _cq = v" />
                    <button class="btn primary" @onclick="NewCit"><Ic N="plus" C="#fff" S="16" /><span>Nova citação</span></button>
                </div>
                <div class="row" style="gap:8px">
                    <span class="muted">Ordenar:</span>
                    <select class="field grow" value="@D.S("ordem", "manual")" @onchange='e => { D["ordem"] = V(e); Win.Save(); }'>
                        @foreach (var (k, t) in SortOpts)
                        {
                            <option value="@k">@t</option>
                        }
                    </select>
                    <span class="muted">Parte:</span>
                    <select class="field grow" value="@_cPart" @onchange="e => _cPart = V(e)">
                        <option value="">Todas</option>
                        <option value="__none__">Sem parte definida</option>
                        @foreach (var p in Parts.Objs())
                        {
                            <option value="@p.S("id")">@p.S("titulo")</option>
                        }
                    </select>
                </div>
                @{
                    var shown = ShownCits();
                    bool manual = D.S("ordem", "manual") == "manual" && (_cq ?? "").Trim().Length == 0 && string.IsNullOrEmpty(_cPart);
                    var pnames = Parts.Objs().ToDictionary(p => p.S("id"), p => p.S("titulo"));
                    bool mai = M.B("autor_maiusc", true);
                }
                <div class="faint">@shown.Count de @Cits.Count citações@(manual && shown.Count > 1 ? " · arraste para reordenar" : "")</div>
                <div class="scroll grow reorder @(_dragKind == "cit" ? "dragging" : "")" style="padding-right:4px">
                    @foreach (var c in shown)
                    {
                        var cc = c;
                        var id = c.S("id");
                        var parteNome = pnames.GetValueOrDefault(c.S("parte"), "");
                        var tr = Collapse(c.S("trecho").Length > 0 ? c.S("trecho") : c.S("nota"));
                        var tit = c.S("titulo");
                        var tags = c.S("tags");
                        <div class="stripcard @(c == _curCit ? "sel" : "") @DropCls("cit", id)" style="--strip:@T["accent2"];margin-bottom:8px;overflow:visible"
                             draggable="@(manual ? "true" : "false")" @ondragstart='() => DragStart("cit", id)' @ondragend="DragEnd" @onclick="() => OnCit(cc)">
                            <div class="col" style="gap:5px;padding:11px 12px 11px 14px">
                                <div class="row" style="gap:6px">
                                    <Chip Text="@TipoNome(c.S("tipo"))" Color="@T["accent"]" Strong="true" />
                                    <Chip Text="@(c.S("modo", "direta") == "indireta" ? "Indireta" : "Direta")" Color="@T["muted"]" />
                                    @if (!string.IsNullOrEmpty(parteNome))
                                    {
                                        <Chip Text="@parteNome" Color="#2f9e44" />
                                    }
                                    <span class="sp"></span>
                                    @if (c.A("usos").Count > 0)
                                    {
                                        <Ic N="check-decagram" C="@T["success"]" S="15" Tip="Já usada no texto" />
                                    }
                                </div>
                                <div class="serif wrap" style="font-size:@Ui.Pt(9.5)">@(tr.Length > 0 ? "“" + tr[..Math.Min(170, tr.Length)] + (tr.Length > 170 ? "…" : "") + "”" : "(sem trecho)")</div>
                                <div class="faint ell">@CitacaoTxt(c, maiusc: mai)  ·  @(tit.Length > 60 ? tit[..60] : tit)</div>
                                @if (tags.Length > 0)
                                {
                                    <div class="faint">@string.Join("  ", tags.Split(',').Select(t => t.Trim()).Where(t => t.Length > 0).Select(t => "#" + t))</div>
                                }
                            </div>
                            @DropZones("cit", id)
                        </div>
                    }
                </div>
            </div>
            @* formulário *@
            <div class="card scroll" style="flex:4;min-width:400px;padding:16px 20px 18px" @onkeydown="FormKey">
                <div class="fgrid">
                    <div class="full row">
                        <div class="h2 grow">@(_curCit != null ? "Editar citação" : "Nova citação")</div>
                        @if (_curCit != null)
                        {
                            <button class="tool" title="Excluir citação" @onclick="DeleteCit"><Ic N="delete-outline" C="@T["danger"]" /></button>
                        }
                    </div>
                    <div class="caption">TIPO DE FONTE</div>
                    <div class="caption">USO</div>
                    <select class="field" value="@_f["tipo"]" @onchange="e => TipoUi(V(e))">
                        @foreach (var (k, t) in TIPOS_FONTE)
                        {
                            <option value="@k">@t</option>
                        }
                    </select>
                    <select class="field" value="@_f["modo"]" @onchange='e => _f["modo"] = V(e)'>
                        <option value="direta">Direta (literal)</option>
                        <option value="indireta">Indireta (paráfrase)</option>
                    </select>
                    <div class="caption full">TRECHO</div>
                    <textarea class="field full" style="min-height:110px" placeholder="Cole aqui o trecho exatamente como está na obra (ou anote a ideia, se for paráfrase)"
                              value="@_f["trecho"]" @oninput='e => _f["trecho"] = V(e)' @ref="_trechoEl"></textarea>
                    @FieldFull("autores", "Autor(es)", "Sobrenome, Nome; Sobrenome, Nome  — ou entidade: BRASIL. Superior Tribunal de Justiça")
                    @FieldFull("titulo", "Título", TituloPh)
                    @if (Show("subtitulo"))
                    {
                        @FieldFull("subtitulo", "Subtítulo", "")
                    }
                    @if (Show("obra"))
                    {
                        @FieldFull("obra", "Título da obra no todo (livro)", "")
                        @FieldFull("obra_autor", "Organizador / autor da obra", "")
                    }
                    @if (Show("edicao"))
                    {
                        <div class="caption">EDIÇÃO</div>
                        <div class="caption">ANO</div>
                        @Input("edicao", "")
                        @Input("ano", "")
                    }
                    else
                    {
                        @FieldFull("ano", "Ano", "")
                    }
                    <div class="caption">LOCAL</div>
                    <div class="caption">@EditoraCap</div>
                    @Input("local", "")
                    @Input("editora", EditoraPh)
                    @if (Show("volume"))
                    {
                        @FieldFull("volume", VolumeCap, VolumePh)
                    }
                    <div class="caption">PÁGINA DO TRECHO</div>
                    <div class="caption">DATA DE ACESSO</div>
                    @Input("pagina", "")
                    @Input("acesso", "AAAA-MM-DD")
                    @FieldFull("url", "Link (URL)", "")
                    <div class="caption">TAGS</div>
                    <div class="caption">USAR NA PARTE</div>
                    @Input("tags", "responsabilidade civil, dano moral")
                    <select class="field" value="@_f["parte"]" @onchange='e => _f["parte"] = V(e)'>
                        <option value="">— nenhuma —</option>
                        @foreach (var p in Parts.Objs())
                        {
                            <option value="@p.S("id")">@p.S("titulo")</option>
                        }
                    </select>
                    <div class="caption full">COMENTÁRIO</div>
                    <textarea class="field full" style="height:70px" placeholder="Sua observação: por que essa citação importa, onde usar…"
                              value="@_f["nota"]" @oninput='e => _f["nota"] = V(e)'></textarea>
                    <div class="caption full" style="margin-top:10px">PRÉ-VISUALIZAÇÃO ABNT</div>
                    <div class="preview full wrap">@((MarkupString)PreviewHtml())</div>
                    <div class="full row" style="gap:8px;margin-top:12px">
                        <button class="btn" title="Copiar a citação formatada" @onclick='() => Copy("cit")'><Ic N="content-copy" S="16" /><span>Citação</span></button>
                        <button class="btn" title="Copiar a referência ABNT" @onclick='() => Copy("ref")'><Ic N="content-copy" S="16" /><span>Referência</span></button>
                        <span class="sp"></span>
                        <button class="btn primary" @onclick="SaveCit"><Ic N="content-save-outline" C="#fff" S="16" /><span>Salvar</span></button>
                    </div>
                </div>
            </div>
        </div>

        @* ─────────────── referências *@
        <div class="col" style="position:absolute;inset:0;gap:10px;padding:16px 22px 14px;display:@(_view == "refs" ? "flex" : "none")">
            <div class="row" style="gap:8px">
                <div class="h2 grow">Referências (ABNT NBR 6023)</div>
                <Segmented Options="RModeOpts" Value="@_rMode" ValueChanged="async v => { _rMode = v; await RefreshRefs(); }" />
                <button class="btn" @onclick="CopyRefs"><Ic N="content-copy" S="16" /><span>Copiar lista</span></button>
            </div>
            <div class="faint wrap">
                Lista gerada automaticamente a partir das suas citações, em ordem alfanumérica, alinhada à esquerda e com espaço simples
                entre linhas. Confira os dados de cada fonte.
            </div>
            <div class="paper grow" style="padding:2px;flex-direction:row">
                <HtmlView @ref="_refs" />
            </div>
        </div>

        @* ─────────────── projeto *@
        <div class="scroll" style="position:absolute;inset:0;background:@T["bg"];display:@(_view == "projeto" ? "block" : "none")">
            <div class="center-col" style="max-width:860px;padding:20px 28px 28px">
                <div class="card" style="padding:20px 24px 22px">
                    <div class="fgrid" style="gap:4px 14px">
                        <div class="h2 full">Dados do trabalho (capa)</div>
                        @MetaFieldFull("titulo", "Título")
                        @MetaFieldFull("subtitulo", "Subtítulo")
                        <div class="caption">AUTOR(A)</div>
                        <div class="caption">ORIENTADOR(A)</div>
                        @MetaInput("autor")
                        @MetaInput("orientador")
                        <div class="caption">INSTITUIÇÃO</div>
                        <div class="caption">CURSO</div>
                        @MetaInput("instituicao")
                        @MetaInput("curso")
                        <div class="caption">CIDADE</div>
                        <div class="caption">ANO</div>
                        @MetaInput("cidade")
                        @MetaInput("ano")
                        <div class="caption full">NATUREZA DO TRABALHO (FOLHA DE ROSTO)</div>
                        <input class="field full" value="@M.S("natureza")" @oninput='e => MetaSet("natureza", V(e))'
                               placeholder="Trabalho de Conclusão de Curso apresentado ao Curso de Direito da … como requisito parcial para a obtenção do título de Bacharel em Direito." />
                    </div>
                </div>
                <div class="card col" style="gap:6px;padding:20px 24px 22px">
                    <div class="h2">Formatação e metas</div>
                    <div class="row" style="gap:14px">
                        <div class="col grow" style="gap:6px">
                            <div class="caption">FONTE</div>
                            <select class="field" value="@M.S("fonte", "Times New Roman")" @onchange='async e => { MetaSet("fonte", V(e)); await RefreshRefs(); }'>
                                <option value="Times New Roman">Times New Roman</option>
                                <option value="Arial">Arial</option>
                            </select>
                        </div>
                        <div class="col grow" style="gap:6px">
                            <div class="caption">META TOTAL DE PALAVRAS</div>
                            <input class="field" value="@M.I("meta_palavras", 12000)" @oninput="MetaWords" />
                        </div>
                    </div>
                    <div class="caption" style="margin-top:6px">AUTOR NA CHAMADA DA CITAÇÃO</div>
                    <select class="field" value="@(M.B("autor_maiusc", true) ? "1" : "0")" @onchange='e => MetaSet("autor_maiusc", V(e) == "1")'>
                        <option value="1">(SILVA, 2020, p. 15) — maiúsculas</option>
                        <option value="0">(Silva, 2020, p. 15) — maiúscula só na inicial</option>
                    </select>
                    <div class="faint wrap">Confira a regra exigida pela sua instituição (NBR 10520). Mudar aqui afeta as próximas citações inseridas.</div>
                </div>
                <div class="card col" style="gap:10px;padding:20px 24px 22px">
                    <div class="h2">Exportar o trabalho completo</div>
                    <div class="muted wrap">
                        Gera capa, folha de rosto, todas as partes na ordem da estrutura (cada uma em nova página) e as referências, com margens ABNT
                        (3 cm superior/esquerda, 2 cm inferior/direita).
                    </div>
                    <div class="row" style="gap:8px">
                        <button class="btn primary" @onclick="ExportPdf"><Ic N="file-pdf-box" C="#fff" S="16" /><span>Exportar PDF</span></button>
                        <button class="btn" @onclick="ExportDoc"><Ic N="file-word-box" S="16" /><span>Exportar Word (.doc)</span></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override string PageKey => "tcc";

    static readonly (string, string, string)[] ViewOpts =
    {
        ("escrever", "Escrever", "pencil-outline"), ("citacoes", "Citações", "format-quote-open"),
        ("refs", "Referências", "bookshelf"), ("projeto", "Projeto", "cog-outline"),
    };
    static readonly (string, string, string)[] QOnlyOpts = { ("parte", "Desta parte", null), ("todas", "Todas", null) };
    static readonly (string, string, string)[] RModeOpts = { ("usadas", "Só as citadas no texto", null), ("todas", "Todas as fontes", null) };
    static readonly (string, string)[] SortOpts =
    {
        ("manual", "Ordem manual (arraste)"), ("autor", "Autor (A–Z)"), ("ano_asc", "Ano (mais antigo)"), ("ano_desc", "Ano (mais recente)"),
        ("recentes", "Adicionadas recentemente"), ("parte", "Por parte do TCC"), ("tipo", "Por tipo de fonte"),
    };
    static readonly string[] FKeys = { "autores", "titulo", "subtitulo", "edicao", "ano", "local", "editora", "volume", "pagina", "url", "acesso", "tags", "obra", "obra_autor" };

    JsonObject D => (JsonObject)Store.Data["tcc"];
    JsonObject M => D.O("meta");
    JsonArray Parts => D.A("parts");
    JsonArray Cits => D.A("cits");
    JsonObject _curPart, _curCit;
    bool _loading;
    Once _saveTimer;
    string _view = "escrever", _pTitle = "", _qq = "", _qOnly = "parte", _cq = "", _cPart = "", _rMode = "todas";
    string _dragKind, _dragId, _dropId;
    int _dropPos;
    readonly Dictionary<string, string> _f = new();
    RichEditor _ed;
    HtmlView _refs;
    SearchBox _qSearch, _cSearch;
    ElementReference _trechoEl;

    string Fonte => string.IsNullOrEmpty(M.S("fonte")) ? "Times New Roman" : M.S("fonte");

    protected override void Init()
    {
        if (Store.Data["tcc"] is not JsonObject t || t.A("parts").Count == 0) Store.Data["tcc"] = TccDefault();
        _saveTimer = new Once(800, () => InvokeAsync(() => { SavePart(); StateHasChanged(); }));
        LoadForm(null);
        if (Parts.Count > 0)
        {
            var first = (JsonObject)Parts[0];
            Post(() => OpenPart(first));

    async Task NewPart()
    {
        var nome = await Win.Ask("Nova parte", "Ex.: Capítulo 4 — Responsabilidade civil", "", icon: "file-plus-outline", ok: "Criar");
        if (string.IsNullOrEmpty(nome)) return;
        SavePart();
        var p = new JsonObject
        {
            ["id"] = Uid(), ["titulo"] = nome, ["html"] = "", ["plain"] = "", ["status"] = "afazer", ["meta"] = 0, ["updated"] = NowIso(),
        };
        int idx = Parts.Count;
        if (Parts.Count > 0 && ((JsonObject)Parts[^1]).S("titulo").ToLowerInvariant().StartsWith("conclus")) idx--;
        Parts.InsertAt(idx, p);
        Win.Save();
        await OpenPart(p);
        await SetView("escrever");
    }

    async Task RenamePart(JsonObject p)
    {
        var nome = await Win.Ask("Renomear parte", "", p.S("titulo"));
        if (string.IsNullOrEmpty(nome)) return;
        p["titulo"] = nome;
        Win.Save();
        if (p == _curPart) _pTitle = nome;
    }

    void SetStatus(JsonObject p, string k)
    {
        p["status"] = k;
        Win.Save();
    }

    async Task SetPartMeta(JsonObject p)
    {
        var v = await Win.Ask("Meta de palavras", $"Quantas palavras você pretende escrever em “{p.S("titulo")}”?",
            p.I("meta") > 0 ? p.I("meta").ToString() : "", icon: "target", ok: "Definir");
        if (v == null) return;
        var digits = Regex.Replace(v, @"\D", "");
        p["meta"] = digits.Length > 0 && int.TryParse(digits, out var n) ? Math.Max(0, n) : 0;
        Win.Save();
    }

    async Task DeletePart(JsonObject p)
    {
        if (!await Win.Confirm("Excluir parte?", $"“{p.S("titulo")}” e todo o texto dela serão excluídos.")) return;
        Parts.Remove(p);
        foreach (var c in Cits.Objs())
            if (c.S("parte") == p.S("id")) c["parte"] = "";
        if (p == _curPart) _curPart = null;
        Win.Save();
        if (Parts.Count > 0) await OpenPart((JsonObject)Parts[0]);
    }

    // ─────────────────────────── escrever
    async Task OpenPart(JsonObject p)
    {
        SavePart();
        _curPart = p;
        _loading = true;
        _pTitle = p.S("titulo");
        await _ed.Load(p.S("html"), false, Fonte);
        _loading = false;
        StateHasChanged();
    }

    string PartInfo()
    {
        var p = _curPart;
        if (p == null) return "";
        int n = Words(_ed?.Plain ?? "");
        int meta = p.I("meta");
        double pag = n / 300.0;
        return $"{n} palavras" + (meta > 0 ? $" de {meta} ({Math.Round(100.0 * n / meta)}%)" : "")
               + $" · ≈ {pag.ToString("0.0", Inv).Replace(".", ",")} página(s) ABNT";
    }

    void TitleEdit(ChangeEventArgs e)
    {
        _pTitle = V(e);
        if (_curPart != null && !_loading)
        {
            _curPart["titulo"] = _pTitle.Length > 0 ? _pTitle : "Sem título";
            _saveTimer.Start();
        }
    }

    void TextChanged()
    {
        if (_loading || _curPart == null) return;
        if (_curPart.S("status") == "afazer" && _ed.Plain.Trim().Length > 0) _curPart["status"] = "escrevendo";
        _saveTimer.Start();
    }

    public void SavePart()
    {
        _saveTimer?.Stop();
        var p = _curPart;
        if (p == null || _loading || _ed == null) return;
        if (_ed.Modified || p.S("titulo") != (_pTitle.Length > 0 ? _pTitle : "Sem título"))
        {
            p["html"] = _ed.FullHtml;
            p["plain"] = _ed.Plain;
            p["updated"] = NowIso();
            _ed.Modified = false;
            Win.Save();
            Win.RefreshCounts();
        }
        else Win.Save();
    }

    public override void Flush() => SavePart();

    // ─────────────────────────── inserir citação
    List<JsonObject> QuickList()
    {
        var q = (_qq ?? "").Trim().ToLowerInvariant();
        bool only = _qOnly == "parte" && _curPart != null;
        return Cits.Objs().Where(c => (!only || c.S("parte") == _curPart.S("id"))
                                      && (q.Length == 0 || (c.S("trecho") + c.S("autores") + c.S("titulo") + c.S("tags")).ToLowerInvariant().Contains(q))).ToList();
    }

    async Task InsertCit(JsonObject c, string modo)
    {
        if (_curPart == null) return;
        bool maiusc = M.B("autor_maiusc", true);
        var tr = Collapse(c.S("trecho"));
        JsonObject o;
        if (modo == "indireta" || tr.Length == 0) o = new JsonObject { ["mode"] = "indireta", ["text"] = CitacaoTxt(c, "indireta", maiusc) };
        else if (modo == "direta") o = new JsonObject { ["mode"] = "direta", ["text"] = $"“{tr}” {CitacaoTxt(c, "direta", maiusc)}" };
        else o = new JsonObject { ["mode"] = "longa", ["text"] = $"{tr} {CitacaoTxt(c, "direta", maiusc)}" };
        o["font"] = Fonte;
        await _ed.Cmd("citation", o);
        var usos = c.A("usos");
        if (!usos.Strs().Contains(_curPart.S("id"))) usos.Add(JsonValue.Create(_curPart.S("id")));
        if (c.S("parte").Length == 0) c["parte"] = _curPart.S("id");
        Win.Save();
        Win.Toast("Citação inserida");
    }

    // ─────────────────────────── citações
    List<JsonObject> Sorted()
    {
        var cits = Cits.List();
        var k = D.S("ordem", "manual");
        var pidx = Parts.Objs().Select((p, i) => (p.S("id"), i)).ToDictionary(x => x.Item1, x => x.i);
        switch (k)
        {
            case "autor": return cits.OrderBy(c => CitAutor(c).ToLowerInvariant(), StringComparer.Ordinal).ThenBy(c => AnoTxt(c), StringComparer.Ordinal).ToList();
            case "ano_asc": return cits.OrderBy(c => AnoTxt(c), StringComparer.Ordinal).ThenBy(c => CitAutor(c).ToLowerInvariant(), StringComparer.Ordinal).ToList();
            case "ano_desc": return cits.OrderByDescending(c => AnoTxt(c), StringComparer.Ordinal).ThenByDescending(c => CitAutor(c).ToLowerInvariant(), StringComparer.Ordinal).ToList();
            case "recentes": return cits.OrderByDescending(c => c.S("created"), StringComparer.Ordinal).ToList();
            case "parte": return cits.OrderBy(c => pidx.TryGetValue(c.S("parte"), out var i) ? i : 999).ToList();
            case "tipo":
                var ordem = TIPOS_FONTE.Select(t => t.key).ToList();
                return cits.OrderBy(c => ordem.IndexOf(c.S("tipo", "livro")) is var i && i >= 0 ? i : 99).ToList();
        }
        return cits;
    }

    List<JsonObject> ShownCits()
    {
        var q = (_cq ?? "").Trim().ToLowerInvariant();
        var pf = _cPart ?? "";
        var outp = new List<JsonObject>();
        foreach (var c in Sorted())
        {
            if (pf == "__none__" && c.S("parte").Length > 0) continue;
            if (pf.Length > 0 && pf != "__none__" && c.S("parte") != pf) continue;
            if (q.Length > 0 && !string.Join(" ", new[] { "trecho", "autores", "titulo", "tags", "nota" }.Select(k => c.S(k))).ToLowerInvariant().Contains(q))
                continue;
            outp.Add(c);
        }
        return outp;
    }


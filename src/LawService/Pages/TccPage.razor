    string FullHtml()
    {
        SavePart();
        var m = M;
        var fam = Fonte;
        string Cen(string t, int mt = 0, bool b = false, double sz = 12) =>
            $"<p align='center' style='margin-top:{mt}px; margin-bottom:0; font-size:{Fmt(sz)}pt; text-align:center;'>"
            + $"{(b ? "<b>" : "")}{Esc(t)}{(b ? "</b>" : "")}</p>";
        var capa = Cen(m.S("instituicao").ToUpperInvariant(), 0, true) + Cen(m.S("curso").ToUpperInvariant(), 0, true)
                   + Cen(m.S("autor").ToUpperInvariant(), 140, true)
                   + Cen(m.S("titulo").ToUpperInvariant(), 160, true)
                   + (m.S("subtitulo").Length > 0 ? Cen(m.S("subtitulo"), 0) : "")
                   + Cen(m.S("cidade"), 260) + Cen(m.S("ano"), 0);
        var rosto = "<p style='page-break-before:always; margin:0;'></p>" + Cen(m.S("autor").ToUpperInvariant(), 0, true)
                    + Cen(m.S("titulo").ToUpperInvariant(), 180, true)
                    + (m.S("subtitulo").Length > 0 ? Cen(m.S("subtitulo"), 0) : "")
                    + "<table width='100%' style='margin-top:90px;'><tr><td width='45%'></td><td>"
                    + $"<p align='justify' style='font-size:10pt; text-align:justify;'>{Esc(m.S("natureza"))}</p>"
                    + $"<p style='font-size:10pt; margin-top:12px;'>Orientador(a): {Esc(m.S("orientador"))}</p>"
                    + "</td></tr></table>"
                    + Cen(m.S("cidade"), 180) + Cen(m.S("ano"), 0);
        var partes = new System.Text.StringBuilder();
        int i = 1;
        foreach (var p in Parts.Objs())
            partes.Append($"<p style='page-break-before:always; margin-bottom:24px; font-size:12pt;'><b>{i++} "
                          + $"{Esc(p.S("titulo").ToUpperInvariant())}</b></p>" + TccBody(p.S("html")));
        var refs = RefList(false);
        var refHtml = "<p align='center' style='page-break-before:always; margin-bottom:24px; text-align:center;'><b>REFERÊNCIAS</b></p>"
                      + string.Concat(refs.Select(c => $"<p style='margin:0 0 14px 0;'>{ReferenciaHtml(c)}</p>"));
        return $"<html><body style=\"font-family:'{fam}'; font-size:12pt;\">" + capa + rosto + partes + refHtml + "</body></html>";
    }


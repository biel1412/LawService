    // ─────────────────────────── referências
    List<JsonObject> RefList(bool onlyUsed)
    {
        var seen = new HashSet<string>();
        var outp = new List<JsonObject>();
        foreach (var c in Cits.Objs())
        {
            if (onlyUsed && c.A("usos").Count == 0) continue;
            var k = FonteKey(c);
            if (seen.Contains(k) || (c.S("titulo").Length == 0 && c.S("autores").Length == 0)) continue;
            seen.Add(k);
            outp.Add(c);
        }
        return outp.OrderBy(c => Norm(ReferenciaPlain(c)), StringComparer.Ordinal).ToList();
    }


    // ─────────────────────────── arrastar para reordenar
    string DropCls(string kind, string id) => _dragKind == kind && _dropId == id ? (_dropPos < 0 ? "drop-before" : "drop-after") : "";

    RenderFragment DropZones(string kind, string id) => __builder =>
    {
        <div class="dz top" @ondragover="() => Over(kind, id, -1)" @ondragover:preventDefault="true" @ondrop="() => Drop(kind)" @ondrop:preventDefault="true"></div>
        <div class="dz bot" @ondragover="() => Over(kind, id, 1)" @ondragover:preventDefault="true" @ondrop="() => Drop(kind)" @ondrop:preventDefault="true"></div>
    };

    void DragStart(string kind, string id)
    {
        _dragKind = kind;
        _dragId = id;
    }

    void DragEnd()
    {
        _dragKind = null;
        _dragId = null;
        _dropId = null;
    }

    void Over(string kind, string id, int pos)
    {
        if (_dragKind != kind) return;
        _dropId = id;
        _dropPos = pos;
    }

    void Drop(string kind)
    {
        var src = _dragId;
        var target = _dropId;
        var pos = _dropPos;
        var k = _dragKind;
        DragEnd();
        if (k != kind || src == null || target == null || src == target) return;
        var arr = kind == "part" ? Parts : Cits;
        IEnumerable<JsonObject> order = kind == "part" ? arr.Objs() : ShownCits();
        var ids = order.Select(o => o.S("id")).ToList();
        ids.Remove(src);
        int ti = ids.IndexOf(target);
        if (ti < 0) return;
        ids.Insert(pos < 0 ? ti : ti + 1, src);
        var by = arr.Objs().ToDictionary(o => o.S("id"));
        var rest = arr.Objs().Where(o => !ids.Contains(o.S("id"))).ToList();
        J.Reset(arr, ids.Where(by.ContainsKey).Select(i => (JsonNode)by[i]).Concat(rest));
        Win.Save();
    }


    async Task FormKey(KeyboardEventArgs e)
    {
        if (e.Key.Equals("s", StringComparison.OrdinalIgnoreCase) && e.CtrlKey) await SaveCit();
    }

    async Task SaveCit()
    {
        var d = FormData();
        if (d.S("trecho").Length == 0 && d.S("titulo").Length == 0)
        {
            await Win.Info("Citação vazia", "Preencha pelo menos o trecho ou o título da obra.", "alert-outline");
            return;
        }
        if (d.S("url").Length > 0 && d.S("acesso").Length == 0) d["acesso"] = IsoDate(Today());
        bool isNew = _curCit == null;
        if (isNew)
        {
            _curCit = new JsonObject { ["id"] = Uid(), ["created"] = NowIso(), ["usos"] = new JsonArray() };
            Cits.Add(_curCit);
        }
        foreach (var kv in d.ToList())
        {
            d.Remove(kv.Key);
            _curCit[kv.Key] = kv.Value;
        }
        _curCit["updated"] = NowIso();
        Win.Save();
        Win.RefreshCounts();
        LoadForm(_curCit);
        Win.Toast(!isNew ? "Citação salva" : "Citação adicionada");
    }

    async Task DeleteCit()
    {
        if (_curCit == null) return;
        if (!await Win.Confirm("Excluir citação?", "A citação sairá da sua biblioteca. O texto já escrito nas partes não é alterado.")) return;
        Cits.Remove(_curCit);
        _curCit = null;
        LoadForm(null);
        Win.Save();
        Win.RefreshCounts();
    }


        Win.ShowMenu(new List<MItem>
        {
            MItem.Async("undo", "Desfazer", () => _ed.Cmd("undo"), enabled: o.B("canUndo") && !ro),
            MItem.Async("redo", "Refazer", () => _ed.Cmd("redo"), enabled: o.B("canRedo") && !ro),
            MItem.Sep(),

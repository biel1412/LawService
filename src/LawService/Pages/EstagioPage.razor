    async Task InsertStructure()
    {
        if (_cur == null || _cur.S("status") == "entregue") return;
        if (_ed.Plain.Trim().Length > 0)
        {
            if (!await Win.Confirm("Inserir estrutura?", "A estrutura será inserida no ponto onde está o "
                                                         + "cursor. Seu texto atual não será apagado.", ok: "Inserir", danger: false, icon: "file-tree-outline"))
                return;
        }
        await _ed.Cmd("insertHtml", EstruturaPeca(_cur));
        await _ed.FocusEditor();
    }

    string FileBase()
    {
        var t = _cur.O("meta").O("tarefa");
        var nome = Regex.Replace($"{t.S("peca").Split(" — ")[0]} - {_cur.S("cliente")}", @"[^\w\- ]", "");
        return nome.Length > 80 ? nome[..80] : nome;
    }

    public async Task ExportPeca()
    {
        if (_cur == null) return;
        SavePeca();
        await Js.PrintHtml(Web.Page(_ed.FullHtml.Length > 0 ? _ed.FullHtml : "<p></p>"), 30, 25, 20, 20);
        Win.Toast("Escolha “Salvar como PDF” na janela de impressão");
    }

    async Task ExportDoc()
    {
        if (_cur == null) return;
        SavePeca();
        await Js.Download($"{FileBase()}.doc", "application/msword", Web.WordDoc("<html><body>" + _ed.Html + "</body></html>"));
        Win.Toast("Arquivo exportado");
    }

    async Task Deliver()
    {
        var c = _cur;
        if (c == null || c.S("status") == "entregue") return;
        SavePeca();
        int n = Words(_ed.Plain);
        if (n < 30)
        {
            await Win.Info("Peça vazia", "Escreva a peça antes de entregar ao chefe.", "alert-outline");
            return;
        }
        var msg = $"A peça tem {n} palavras. Depois de entregue, ela fica bloqueada para edição.";
        if (n < 250)
            msg = $"A peça está curta ({n} palavras). Tem certeza de que está completa? Depois de entregue, ela "
                  + "fica bloqueada para edição.";
        if (!await Win.Confirm("Entregar ao chefe?", msg, ok: "Entregar", danger: false, icon: "send-outline")) return;
        var t = c.O("meta").O("tarefa");
        var agora = DateTime.Now;
        var s = c.O("socio");
        c["status"] = "entregue";
        c["entregue_em"] = agora.ToString("yyyy-MM-dd'T'HH:mm:ss", Inv);
        var emails = c.A("emails");
        var assunto0 = emails.Objs().First().S("assunto");
        emails.Add(new JsonObject
        {
            ["de"] = "Você", ["email"] = $"estagio@{Est.FIRMA_DOMINIO}", ["para"] = s.S("nome"), ["data"] = c.S("entregue_em"),
            ["tipo"] = "estagiario", ["anexos"] = new JsonArray("MINUTA"), ["assunto"] = "Re: " + assunto0,
            ["html"] = $"<p>{Esc(s.S("nome").Split(' ')[0])} {Esc(s.S("curto"))}, segue a minuta de "
                       + $"<b>{Esc(t.S("peca").Split(" — ")[0].ToLowerInvariant())}</b> do caso "
                       + $"{Esc(c.S("titulo"))} para sua revisão.</p><p>Fico à disposição para ajustes.</p>",
        });
        var rnd = new Random();
        var resp = agora.AddMinutes(rnd.Next(12, 56)).ToString("yyyy-MM-dd'T'HH:mm:ss", Inv);
        var ok_txt = new[]
        {
            "Recebi, obrigad{a}! Vou revisar ainda hoje e, estando tudo certo, protocolo.",
            "Obrigad{a} pela minuta! Vou ler com calma, fazer os ajustes finais e peticionar.",
            "Chegou aqui. Dou uma revisada e já protocolo no sistema.",
        }[rnd.Next(3)].Replace("{a}", s.B("f") ? "a" : "o");
        emails.Add(new JsonObject
        {
            ["de"] = s.S("nome"), ["email"] = $"{s.S("email")}@{Est.FIRMA_DOMINIO}", ["para"] = "você", ["data"] = resp, ["tipo"] = "socio",
            ["assunto"] = "Re: " + assunto0, ["anexos"] = new JsonArray(),
            ["html"] = $"<p>Oi, %%NOME%%. {ok_txt}</p>"
                       + "<p>Uma dica: se quiser um retorno detalhado sobre a sua peça — estrutura, fundamentos, pedidos e "
                       + "linguagem —, peça a <b>correção com um profissional recomendado</b>. O professor analisa o seu "
                       + "texto e conversa com você por videochamada. É a forma mais rápida de evoluir.</p>"
                       + $"<p>{Assin(s)}</p>",
        });
        Protocolar(c, agora);
        Win.Save();
        await OpenCase(c);
        Win.Toast("Peça entregue ao chefe");
    }

    static string Assin(JsonObject s) =>
        $"Abraço,<br><b>{s.S("nome")}</b><br><span style='color:#6b7186'>{s.S("cargo")}<br>{Est.FIRMA}</span>";

    void Protocolar(JsonObject c, DateTime agora)
    {
        var t = c.O("meta").O("tarefa");
        var s = c.O("socio");
        var corpo = _ed.Html;
        var code = t.S("code", "PET");
        if (code.Length == 0) code = "PET";
        var hoje = Today();
        if (!c.B("processo_existe"))
        {
            var meta = c.O("meta");
            var num = meta.S("numero");
            var mm = Regex.Match(num, @"^(\d{7})-\d{2}\.(\d{4})\.(\d)\.(\d{2})\.(\d{4})$");
            if (mm.Success)
            {
                var b = $"{mm.Groups[1].Value}{hoje.Year}{mm.Groups[3].Value}{mm.Groups[4].Value}{mm.Groups[5].Value}";
                meta["numero"] = $"{mm.Groups[1].Value}-{Est.CnjDv(b):D2}.{hoje.Year}.{mm.Groups[3].Value}.{mm.Groups[4].Value}.{mm.Groups[5].Value}";
            }
            c["processo_existe"] = true;
            var docs = new JsonArray(new JsonObject { ["code"] = "INIC1", ["title"] = t.S("peca").Split(" — ")[0], ["html"] = corpo });
            foreach (var a in c.A("anexos").Objs())
                docs.Add(new JsonObject { ["code"] = a.S("code"), ["title"] = a.S("title"), ["html"] = a.S("html") });
            c["eventos"] = new JsonArray(
                new JsonObject
                {
                    ["n"] = 1, ["date"] = IsoDate(hoje), ["time"] = agora.ToString("HH:mm:ss"), ["desc"] = "DISTRIBUÍDO POR SORTEIO",
                    ["user"] = s.S("nome").Up(), ["detail"] = meta.S("orgao"), ["docs"] = docs,
                },
                new JsonObject
                {
                    ["n"] = 2, ["date"] = IsoDate(hoje), ["time"] = agora.AddMinutes(3).ToString("HH:mm:ss"),
                    ["desc"] = "CONCLUSOS PARA DECISÃO/DESPACHO", ["user"] = "SISTEMA", ["detail"] = "", ["docs"] = new JsonArray(),
                });
            return;
        }
        var evs = c.A("eventos");
        foreach (var e in evs.Objs())
            if (e.Get("prazo") is JsonObject p && p.S("status") == "ABERTO") p["status"] = "FECHADO";
        int n = evs.Count + 1;
        var desc = t.S("tipo") == "agravo"
            ? "COMUNICAÇÃO DE INTERPOSIÇÃO DE AGRAVO DE INSTRUMENTO (ART. 1.018 DO CPC)"
            : t.S("peca").Split(" (")[0].Split(" — ")[0].Up();
        evs.Add(new JsonObject
        {
            ["n"] = n, ["date"] = IsoDate(hoje), ["time"] = agora.ToString("HH:mm:ss"), ["desc"] = desc, ["user"] = s.S("nome").Up(),
            ["detail"] = "Petição protocolada pelo escritório",
            ["docs"] = new JsonArray(new JsonObject { ["code"] = $"{code}1", ["title"] = t.S("peca").Split(" — ")[0], ["html"] = corpo }),
        });
    }

    /// <summary>Diálogo da correção profissional.</summary>
    public async Task AskCorrection()
    {
        if (_cur == null) return;
        SavePeca();
        var c = _cur;
        var url = CorrecaoUrl();
        DialogState d = null;
        d = new DialogState
        {
            Width = 560,
            Body = __builder =>
            {
                <div class="row top" style="gap:14px">
                    <div class="icon-badge" style="width:48px;height:48px;border-radius:14px;background:@T["accent_soft"]"><Ic N="account-tie-voice-outline" C="@T["accent"]" S="26" /></div>
                    <div class="col grow" style="gap:4px">
                        <div class="h2 wrap">Correção de profissional recomendado</div>
                        <div class="muted wrap">Um professor corrige a sua peça e conversa com você por videochamada, apontando acertos, erros de estrutura, fundamentos e pedidos.</div>
                    </div>
                </div>
                int i = 1;
                foreach (var (icn, tt, dd) in new[]
                {
                    ("file-pdf-box", "Exporte a sua peça em PDF", "Você vai anexá-la no formulário."),
                    ("credit-card-outline", "Faça o pagamento e preencha o formulário", "Na página que vai abrir, com seus dados e a peça."),
                    ("video-outline", "O professor entra em contato", "Para agendar a correção por videochamada."),
                })
                {
                    <div class="row" style="gap:12px;padding:10px 14px;background:@T["surface2"];border:1px solid @T["border"];border-radius:12px">
                        <span class="avatar" style="width:28px;height:28px;background:@T["accent"]">@(i++)</span>
                        <div class="col grow"><b>@tt</b><span class="faint">@dd</span></div>
                        <Ic N="@icn" C="@T["muted"]" S="20" />
                    </div>
                }
                if (string.IsNullOrEmpty(url))
                {
                    <div class="wrap" style="background:@T["warn_soft"];border-radius:10px;padding:10px 12px;color:@Ink(T["warn"], .35)">
                        O link do formulário ainda não foi configurado. Peça o link ao seu professor e cadastre em Estágio › engrenagem.
                    </div>
                }
                <div class="row" style="gap:8px">
                    <button class="btn" @onclick="ExportPeca"><Ic N="file-pdf-box" S="16" /><span>Exportar minha peça (PDF)</span></button>
                    <span class="sp"></span>
                    <button class="btn ghost" @onclick="() => Win.CloseDialog(d, null)">Fechar</button>
                    @if (!string.IsNullOrEmpty(url))
                    {
                        <button class="btn primary" @onclick='() => Win.CloseDialog(d, "go")'><Ic N="open-in-new" C="#fff" S="16" /><span>Ir para o pagamento e formulário</span></button>
                    }
                    else
                    {
                        <button class="btn primary" @onclick='() => Win.CloseDialog(d, "config")'><Ic N="cog-outline" C="#fff" S="16" /><span>Configurar link</span></button>
                    }
                </div>
            },
        };
        var r = await Win.OpenDialog(d);
        if (r == "go")
        {
            await Js.OpenUrl(CorrecaoUrl());
            c["correcao"] = true;
            Win.Save();
        }
        else if (r == "config") await OpenSettings();
    }

    // ─────────────────────────── casos
    async Task NovoCaso(string area = null, string fase = null)
    {
        if (string.IsNullOrEmpty(EstSettings().S("estagiario")))
        {
            var nome = await Win.Ask("Bem-vindo ao escritório!", $"Você é o(a) novo(a) estagiário(a) de {Est.FIRMA}. "
                                                                 + "Como devemos te chamar?", "", icon: "account-outline", ok: "Começar",
                placeholder: "Seu nome");
            if (string.IsNullOrEmpty(nome)) return;
            EstSettings()["estagiario"] = nome;
        }
        var evitar = new HashSet<(string, string)>(Cases.Objs().TakeLast(12).Select(c => (c.S("familia"), c.S("variante"))));
        var caso = Casos.GerarCaso(area, fase, evitar);
        Cases.Add(caso);
        Win.Save();
        if (_filter == "entregues") _filter = "abertos";
        await OpenCase(caso);
        Win.Toast("Novo e-mail na caixa de entrada");
    }

    async Task DeleteCase(JsonObject c)
    {
        if (!await Win.Confirm("Excluir caso?", "O caso, o processo e a sua peça serão excluídos.")) return;
        Cases.Remove(c);
        if (c == _cur) _cur = null;
        Win.Save();
        if (Cases.Count > 0) await OpenCase((JsonObject)Cases[Cases.Count - 1]);
        Win.RefreshCounts();
    }

    /// <summary>Configurações do estágio.</summary>
    public async Task OpenSettings()
    {
        var nome = EstSettings().S("estagiario");
        var url = EstSettings().S("correcao_url");
        bool showUrl = string.IsNullOrEmpty(Est.CORRECAO_URL);
        DialogState d = null;
        d = new DialogState
        {
            Width = 500,
            Body = __builder =>
            {
                <div class="col" style="gap:10px" @onkeydown='e => { if (e.Key == "Enter") Win.CloseDialog(d, "ok"); }'>
                    <div class="h2">Configurações do estágio</div>
                    <div class="caption">SEU NOME</div>
                    <input class="field" placeholder="Como o seu chefe vai te chamar nos e-mails" value="@nome" @oninput="e => nome = V(e)" @ref="d.InputRef" />
                    @if (showUrl)
                    {
                        <div class="caption" style="margin-top:6px">LINK DA CORREÇÃO PROFISSIONAL</div>
                        <input class="field" placeholder="https://… (página de pagamento / formulário)" value="@url" @oninput="e => url = V(e)" />
                    }
                    <div class="row" style="gap:8px;margin-top:6px">
                        <span class="sp"></span>
                        <button class="btn" @onclick="() => Win.CloseDialog(d, null)">Cancelar</button>
                        <button class="btn primary" @onclick='() => Win.CloseDialog(d, "ok")'>Salvar</button>
                    </div>
                </div>
            },
        };
        if (await Win.OpenDialog(d) != "ok") return;
        EstSettings()["estagiario"] = (nome ?? "").Trim();
        if (showUrl)
        {
            var u = (url ?? "").Trim();
            if (u.Length > 0 && !Regex.IsMatch(u, "^https?://")) u = "https://" + u;
            EstSettings()["correcao_url"] = u;
        }
        Win.Save();
    }

    public async Task OpenById(string id)
    {
        var c = Cases.Objs().FirstOrDefault(x => x.S("id") == id);
        if (c == null) return;
        _filter = "todos";
        _q = "";
        await OpenCase(c);
    }

    public override void FocusSearch() => _ = _search.FocusAll();
    public override void CtrlN() => _ = NovoCaso();

    public int Pendentes() => Cases.Objs().Count(c => c.S("status") != "entregue");

@{
    var v = Math.Max(0, Math.Min(1, Value));
    var w = 6.0;
    var r = (Size - w - 2) / 2;
    var c = Size / 2;
    var len = 2 * Math.PI * r;
    var col = Color ?? T["accent"];
}
<svg class="ring" width="@Size" height="@Size" viewBox="0 0 @Size @Size">
    <defs>
        <linearGradient id="@_id" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="@col" />
            <stop offset="1" stop-color="@Mix(col, T["accent2"], .5)" />
        </linearGradient>
    </defs>
    <circle cx="@c" cy="@c" r="@r" fill="none" stroke="@T["hover"]" stroke-width="@w" />
    @if (v > 0)
    {
        <circle cx="@c" cy="@c" r="@r" fill="none" stroke="url(#@_id)" stroke-width="@w" stroke-linecap="round"
                stroke-dasharray="@($"{len * v:0.##} {len:0.##}")" transform="rotate(-90 @c @c)" />
    }
    <text x="50%" y="50%" text-anchor="middle" dominant-baseline="central" fill="@T["text"]" font-weight="700" font-size="13.3">@(Math.Round(v * 100))%</text>
</svg>
@code {
    readonly string _id = "rg" + Uid();
    [Parameter] public double Size { get; set; } = 58;
    [Parameter] public double Value { get; set; }
    [Parameter] public string Color { get; set; }
}

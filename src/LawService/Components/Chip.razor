<span class="chip" style="background:@Tint(Color, .86);color:@Ink(Color, .22);font-weight:@(Strong ? 700 : 600)" title="@Tip">@Text</span>
@code {
    [Parameter] public string Text { get; set; }
    [Parameter] public string Color { get; set; }
    [Parameter] public bool Strong { get; set; }
    [Parameter] public string Tip { get; set; }
}
